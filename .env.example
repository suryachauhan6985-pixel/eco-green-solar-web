# Eco Green Solar ERP - Environment Configuration

# Server Port (Default: 5000)
PORT=5000
NODE_ENV=development

# Database Settings (MySQL / MariaDB / TiDB Cloud)
# Agar aap TiDB Cloud use kar rahe hain to Host, User, Password aur DB_SSL=true daalein
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=eco_green_solar
DB_SSL=false

# Security / Authentication
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=10y
